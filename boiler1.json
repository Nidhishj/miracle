"Factorial And Modular Inverse": {
  "prefix": "factmodinv",
  "body": [
    "vi fact(int n, int mod = MOD) {",
    "    vi f(n + 1, 1);",
    "    for (int i = 2; i <= n; i++)",
    "        f[i] = (f[i - 1] * i) % mod;",
    "    return f;",
    "}",
    "",
    "vi invfact(int n, int mod = MOD) {",
    "    vi facts = fact(n, mod);",
    "    vi invf(n + 1, 1);",
    "    invf[n] = modexp(facts[n], mod - 2, mod);",
    "    for (int i = n - 1; i >= 0; i--)",
    "        invf[i] = (invf[i + 1] * (i + 1)) % mod;",
    "    return invf;",
    "}"
