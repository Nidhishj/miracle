    "            largest_prime_factor[multiple] = prime;",
    "        }",
    "    }",
    "",
    "    for (int value = 2; value <= n; ++value) {",
    "        int remaining = value;",
    "        while (remaining > 1) {",
    "            int prime = largest_prime_factor[remaining];",
    "            mp[value].push_back(prime);",
    "            remaining /= prime;",
    "        }",
    "    }",
    "",
    "    return mp;",
    "}"
  ],
  "description": "Return all prime factors, including repetitions, for every value from 1 to n"
}
