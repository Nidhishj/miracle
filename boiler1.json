"Get_divisors":{
  "prefix": "get_div",
  "body": [
    "vector<int> get_divisors(int n) {",
    "    vector<int> divisors;",
    "    for (int i = 1; i <= n / i; ++i) {",
    "        if (n % i == 0) {",
    "            divisors.push_back(i);",
    "            if (i != n / i) {",
    "                divisors.push_back(n / i);",
    "            }",
    "        }",
    "    }",
    "    sort(divisors.begin(), divisors.end());",
    "    return divisors;",
    "}"
  ],
  "description": "Get all divisors of a number"
