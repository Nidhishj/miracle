    "int modexp(int base, int exp, int mod = MOD) {",
    "    if (exp == 0) return 1;",
    "    int half = modexp(base, exp / 2, mod);",
    "    int result = (1LL * half * half) % mod;",
    "    if (exp % 2 == 1) result = (1LL * result * base) % mod;",
    "    return result;",
    "}"
