		"prefix": "bfs",
		"body": [
			"void bfs(int start, vector<vector<int>> &adj, vector<bool>&visited) {",
			"  queue<int> q;",
			"  q.push(start);",
			"  visited[start] = true;",
			"",
			"  while (!q.empty()) {",
			"    int node = q.front();",
			"    q.pop();",
			// "    cout << node << ' ';",
			"",
			"    for (int neighbor : adj[node]) {",
			"      if (!visited[neighbor]) {",
			"        visited[neighbor] = true;",
			"        q.push(neighbor);",
			"      }",
			"    }",
			"  }",
			"}"
		],
		"description": "Breadth-First Search function for graphs"
	},
